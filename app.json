{
  "expo": {
    "name": "AllCrochet",
    "slug": "AllCrochet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AllCrochet-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/AllCrochet-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.AllCrochet",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AllCrochet-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.AllCrochet"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "529ea754-3f7e-4b73-b461-fdcb897fec9b"
      }
    },
    "owner": "junel_azares"
  }
}
